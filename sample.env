# Core feature flags
AI_ENABLED=true
AI_TEXT_ENABLED=true
AI_VISION_ENABLED=false
AI_OCR_ENABLED=false

# Shared internal API key. Generate with: openssl rand -hex 32
AI_API_KEY=replace-with-a-long-random-key

# Text model. Keep this aligned with the model preloaded by deploy.sh.
AI_MODEL=qwen2.5:3b
AI_VISION_MODEL=qwen2.5vl:3b

# CPU-only inference: do not raise this without a measured benchmark.
AI_CONCURRENCY=1
AI_TEXT_CONTEXT=8192
AI_IMAGE_CONTEXT=4096
AI_TEXT_TIMEOUT_MS=120000
AI_IMAGE_TIMEOUT_MS=300000
AI_MAX_RETRIES=1
AI_MIN_CONFIDENCE=0.6
AI_MAX_TEXT_CHARS=32000

# Reserved for the later vision phase.
AI_MAX_PHOTOS_PER_LISTING=5
AI_IMAGE_MAX_WIDTH=1280
AI_IMAGE_MAX_HEIGHT=1280

# Cache/provenance. Increment versions when schemas or prompts change.
PROMPT_VERSION=1
SCHEMA_VERSION=1
AI_CACHE_TTL_MS=86400000

# Docker resource limits for a 4-vCPU / 16-GB host.
OLLAMA_CPUS=3.0
OLLAMA_MEMORY_LIMIT=8g
AI_WORKER_CPUS=0.75
AI_WORKER_MEMORY_LIMIT=1g
AI_REDIS_MEMORY_LIMIT=384m
