# Core feature flags
AI_ENABLED=true
AI_TEXT_ENABLED=true
AI_VISION_ENABLED=false
AI_OCR_ENABLED=false

# Shared internal API key. Generate with: openssl rand -hex 32
AI_API_KEY=replace-with-a-long-random-key

# Qwen stays dedicated to semantic apartment/vacancy parsing.
AI_MODEL=qwen3.5:2b
AI_VISION_MODEL=qwen3.5:2b
AI_THINK=false

# Dedicated interactive translation service. Normal translation never enters the
# Qwen queue; this fallback keeps the button usable if the translator is down.
TRANSLATION_SERVICE_TIMEOUT_MS=30000
TRANSLATION_FALLBACK_TO_QWEN=true
TRANSLATOR_THREADS=2
TRANSLATOR_MAX_SOURCE_TOKENS=420

# Production model storage on the separately mounted data disk. Leave unset to
# use Docker's managed `ollama-data` volume during local development.
# OLLAMA_DATA_PATH=/mnt/docker-data/ollama

AI_CONCURRENCY=1
AI_TEXT_CONTEXT=8192
AI_IMAGE_CONTEXT=4096
AI_TEXT_TIMEOUT_MS=120000
AI_TRANSLATION_TIMEOUT_MS=180000
AI_IMAGE_TIMEOUT_MS=300000
AI_MAX_RETRIES=1
AI_MIN_CONFIDENCE=0.6
AI_MAX_TEXT_CHARS=32000

# Reserved for the later vision phase.
AI_MAX_PHOTOS_PER_LISTING=5
AI_IMAGE_MAX_WIDTH=1280
AI_IMAGE_MAX_HEIGHT=1280

# Cache/provenance. Translation results are intentionally retained longer.
PROMPT_VERSION=1
SCHEMA_VERSION=3
AI_CACHE_TTL_MS=86400000
AI_TRANSLATION_CACHE_TTL_MS=604800000

# Docker resource limits for a 6-vCPU / 16-GB host. Ollama and the dedicated
# translator may run at the same time, so do not allocate five cores to Ollama
# anymore: 4 + 1.5 + worker headroom avoids heavy CPU oversubscription.
OLLAMA_CPUS=4.0
OLLAMA_MEMORY_LIMIT=8g
TRANSLATOR_CPUS=1.5
TRANSLATOR_MEMORY_LIMIT=2g
AI_WORKER_CPUS=0.5
AI_WORKER_MEMORY_LIMIT=1g
AI_REDIS_MEMORY_LIMIT=384m
