# Core feature flags
AI_ENABLED=true
AI_TEXT_ENABLED=true
AI_VISION_ENABLED=true

# Shared internal API key. Generate with: openssl rand -hex 32
AI_API_KEY=replace-with-a-long-random-key

# Qwen handles semantic apartment/vacancy/candidate parsing and translation fallback.
AI_MODEL=qwen3.5:2b
AI_THINK=false

# Dedicated interactive translation service. Normal translation stays on M2M100;
# Qwen is used only when the dedicated translator is unavailable/invalid.
TRANSLATION_SERVICE_TIMEOUT_MS=30000
TRANSLATION_FALLBACK_TO_QWEN=true
TRANSLATOR_THREADS=2
TRANSLATOR_MAX_SOURCE_TOKENS=420

# Vision provider chain, tried in order with a per-provider cooldown after a
# retryable failure. "ollama" is also available (runs locally against AI_MODEL)
# but is NOT included by default: on a CPU-only host it can take minutes per
# photo even with the smallest multimodal model, so only add it if you have
# GPU-accelerated Ollama or don't mind very slow background vision jobs.
VISION_PROVIDERS=groq,cloudflare
VISION_CONCURRENCY=1
VISION_PROVIDER_TIMEOUT_MS=30000
VISION_COOLDOWN_MS=300000
VISION_CACHE_TTL_MS=2592000000
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# Defaults to AI_MODEL. Only set this if the vision model must differ from the
# text model - Ollama keeps one model loaded at a time, so using two different
# models means every text<->vision switch reloads the model from disk.
OLLAMA_VISION_MODEL=
OLLAMA_VISION_TIMEOUT_MS=180000

# Production model storage on the separately mounted data disk.
# OLLAMA_DATA_PATH=/mnt/docker-data/ollama

# Bounded in-process executor. Durable caller state remains in flat-finder/Postgres
# and Personal-Site's persistent state volume; ai-worker itself is restart-safe.
AI_CONCURRENCY=1
AI_QUEUE_MAX_PENDING=100
AI_TEXT_CONTEXT=8192
AI_TEXT_TIMEOUT_MS=120000
AI_TRANSLATION_TIMEOUT_MS=180000
AI_MAX_RETRIES=1
AI_MIN_CONFIDENCE=0.6
AI_MAX_TEXT_CHARS=32000
AI_MAX_PHOTOS_PER_LISTING=4

# Bounded process-local LRU/TTL cache. Translation results are retained longer.
PROMPT_VERSION=1
SCHEMA_VERSION=3
AI_CACHE_MAX_ENTRIES=2000
AI_CACHE_TTL_MS=86400000
AI_TRANSLATION_CACHE_TTL_MS=604800000

# Docker resource limits for a 6-vCPU / 16-GB host.
OLLAMA_CPUS=4.0
OLLAMA_MEMORY_LIMIT=8g
TRANSLATOR_CPUS=1.5
TRANSLATOR_MEMORY_LIMIT=2g
AI_WORKER_CPUS=0.5
AI_WORKER_MEMORY_LIMIT=1g
